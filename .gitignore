# Home Assistant demo instance runtime state (docker/docker-compose.demo.yml)
# Contains generated auth tokens/secrets — never commit. The seed
# configuration.yaml is tracked on purpose so the demo instance is
# reproducible after a wipe (see docker/README.md).
docker/ha_config/*
!docker/ha_config/configuration.yaml
!docker/ha_config/virtual_sensors.yaml
!docker/ha_config/virtual_binary_sensors.yaml

# Home Assistant E2E instance runtime state (docker-compose.e2e.yml). Same
# reasoning as docker/ha_config/* above — the seed config is tracked so the
# E2E instance's fixture entities (used by tests_e2e/) are reproducible on a
# fresh checkout instead of depending on local, uncommitted state.
docker/ha_config_e2e/*
!docker/ha_config_e2e/configuration.yaml
!docker/ha_config_e2e/virtual_sensors.yaml
!docker/ha_config_e2e/virtual_binary_sensors.yaml

# pytest/coverage output
test-results/

# Local scratch note for content pending an external MCP sync — not project state.
.reqogniloom-pending-sync.md
